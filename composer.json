{
    "name": "onlime/laravel-sql-reporter",
    "description": "Log SQL queries in Laravel framework",
    "type": "library",
    "keywords": ["laravel", "sql", "log", "logger", "sql logger", "log sql queries", "log sql", "sql log"],
    "homepage": "https://github.com/onlime/laravel-sql-reporter",
    "license": "MIT",
    "authors": [
        {
            "name": "Philip Iezzi",
            "email": "philip@onlime.ch",
            "role": "Developer"
        },
        {
            "name": "Onlime GmbH",
            "homepage": "https://www.onlime.ch/"
        }
    ],
    "support": {
        "issues": "https://github.com/onlime/laravel-sql-reporter/issues",
        "source": "https://github.com/onlime/laravel-sql-reporter"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6.13",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.7 || ^5.3"
    },
    "suggest": {
        "stevebauman/location": "GeoIP country detection for the client IP in log headers"
    },
    "autoload": {
        "psr-4": {
            "Onlime\\LaravelSqlReporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Onlime\\LaravelSqlReporter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --coverage-html=build/coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Onlime\\LaravelSqlReporter\\Providers\\SqlReporterServiceProvider"
            ]
        },
        "thanks": {
            "name": "mnabialek/laravel-sql-logger",
            "url": "https://github.com/mnabialek/laravel-sql-logger"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
